# Kopier til .env for lokal utvikling. I Vercel: Project → Settings → Environment Variables.
# Ingen av disse skal sjekkes inn i Git.

# --- Rapportering (byggetid; krever ny deploy etter endring) ---
# Google Tag Manager container-ID for bedriftens EGEN container, f.eks. GTM-XXXXXXX
GTM_ID=
# GA4 måle-ID, f.eks. G-XXXXXXXXXX. Brukes bare hvis GTM_ID er tom (direkte gtag.js).
GA4_ID=
# Verifiseringskode for Google Search Console (HTML-tag-metoden). Valgfri – DNS-verifisering anbefales.
GSC_VERIFICATION=
# Sett til 1 på preview-miljøer for å legge noindex på alle sider.
NOINDEX=

# --- Kontaktskjema (kjøretid) ---
# Mottaker av skjemaet
KONTAKT_TIL=post@nsbetong.no
# Hvilken e-posttjeneste som sender: "graph" (Microsoft 365, anbefalt) eller "resend"
EPOST_LEVERANDOR=graph

# Microsoft Graph (app-registrering i Entra ID med Mail.Send, begrenset til én postboks)
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Postboksen e-posten sendes FRA (må finnes i M365), f.eks. post@nsbetong.no
MS_AVSENDER=post@nsbetong.no

# Resend (alternativ). Krever verifisert avsenderdomene hos Resend.
RESEND_API_KEY=
RESEND_FRA=Nettside <skjema@nsbetong.no>

# Sett til 1 for å teste skjemaet uten å sende e-post (logger bare). ALDRI i produksjon.
SKJEMA_TESTMODUS=
