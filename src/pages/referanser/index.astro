---
import Base from '../../layouts/Base.astro';
import Sidehero from '../../components/Sidehero.astro';
import Faktaband from '../../components/Faktaband.astro';
import Prosjektkort from '../../components/Prosjektkort.astro';
import Byggherrer from '../../components/Byggherrer.astro';
import CtaBand from '../../components/CtaBand.astro';
import { referanser, referanseIngress, referanseEtterSlug, totalt } from '../../data/referanser';
import { tjenester } from '../../data/tjenester';

const smuler = [{ navn: 'Forside', sti: '/' }, { navn: 'Referanser', sti: '/referanser/' }];
const heroBilde = referanseEtterSlug('utvidelse-av-fortoyningsanlegg-co2-anlegg-kollsnes').bilde.src;
const filtre = tjenester.filter((t) => referanser.some((r) => r.tjenester.includes(t.slug)));
---
<Base
  tittel="Referanser – betongarbeid i Vestland | Nilsen & Sture Betong"
  beskrivelse="Referanser fra Nilsen & Sture Betong: Kollsnes for Equinor, Bergen Verksted, Skostredet Hotel, Sædalen kirke og flere prosjekter i Vestland."
  smuler={smuler}
  ogBilde={heroBilde}
>
  <Sidehero tittel="Referanser" overtittel="Prosjekter" ingress={referanseIngress} bilde={heroBilde} smuler={smuler} />

  <Faktaband
    fakta={[
      { verdi: String(totalt.prosjekter), etikett: 'Utvalgte prosjekter', ikon: 'bygg' },
      { verdi: `${totalt.betongM3.toLocaleString('nb-NO')} m³`, etikett: 'Levert betong', ikon: 'betong' },
      { verdi: `${totalt.kontraktMill} mill. kr`, etikett: 'Samlet kontraktsverdi', ikon: 'kontrakt' },
      { verdi: '2019–2024', etikett: 'Byggeperioder', ikon: 'kalender' },
    ]}
  />

  <section class="seksjon" aria-labelledby="alle-tittel">
    <div class="beholder">
      <div class="seksjonstopp">
        <div>
          <p class="overtittel">Referanseprosjekter</p>
          <h2 id="alle-tittel">Alle prosjekter</h2>
        </div>
        <div class="filter" data-filter role="group" aria-label="Filtrer etter tjeneste" hidden>
          <button type="button" data-verdi="alle" aria-pressed="true">Alle</button>
          {filtre.map((t) => <button type="button" data-verdi={t.slug} aria-pressed="false">{t.kortnavn}</button>)}
        </div>
      </div>
      <p class="visuelt-skjult" aria-live="polite" data-filter-antall></p>
      <ul class="prosjektliste" data-filter-mal>
        {referanser.map((r, i) => (
          <li class:list={{ bred: i % 5 === 0 }} data-vis style={`--i: ${i % 3}`}>
            <Prosjektkort r={r} overskrift="h3" storrelse={i % 5 === 0 ? 'stor' : 'normal'} />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <Byggherrer />

  <CtaBand kilde="referanser" tittel="Nytt prosjekt?" tekst="Vi holder til på Askøy og hjelper både privatpersoner og profesjonelle aktører i hele Vestland. Kontakt oss for gratis befaring." />
</Base>

<style>
  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .filter button {
    font-family: var(--font-overskrift);
    font-size: 0.95rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    min-height: 44px;
    padding: 0.5rem 1.1rem;
    border: 1px solid var(--farge-linje);
    border-radius: 999px;
    background: #fff;
    color: var(--farge-mork);
    cursor: pointer;
    transition:
      background-color 0.15s,
      color 0.15s,
      border-color 0.15s;
  }
  .filter button:hover {
    border-color: var(--farge-mork);
  }
  .filter button[aria-pressed='true'] {
    background: var(--farge-aksent);
    border-color: var(--farge-aksent);
    color: #fff;
  }
  .prosjektliste {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
  }
  @media (min-width: 40rem) {
    .prosjektliste {
      grid-template-columns: repeat(2, 1fr);
    }
    .prosjektliste .bred {
      grid-column: span 2;
    }
  }
  @media (min-width: 62rem) {
    .prosjektliste {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  .prosjektliste li :global(.pkort) {
    height: 100%;
  }
</style>
