---
import { Picture, getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Ikon from '../components/Ikon.astro';
import Tjenestekort from '../components/Tjenestekort.astro';
import Tillitsmerker from '../components/Tillitsmerker.astro';
import CtaBand from '../components/CtaBand.astro';
import { firma, telLenke, epostLenke } from '../data/site';
import { organisasjonLd } from '../data/jsonld';
import { referanser, formatM3 } from '../data/referanser';
import heroBilde from '../assets/bilder/forside/armering-av-betongdekke-bergen.jpg';
import omOssBilde from '../assets/bilder/felles/prosjektmote-over-tegninger.jpg';
import karriereBilde from '../assets/bilder/felles/nilsen-sture-betong-ansatt-ved-firmabil.jpg';

const ldBilde = await getImage({ src: heroBilde, width: 1200, format: 'jpg' });
const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${firma.url}/#nettsted`,
  url: `${firma.url}/`,
  name: firma.navn,
  inLanguage: 'nb-NO',
  publisher: { '@id': `${firma.url}/#firma` },
};
const utvalgteReferanser = referanser.filter((r) =>
  ['Domkirkegaten 6, Skostredet Hotel', 'Sædalen kirke', 'Ny sykkelveg, Carl Konows gate'].includes(r.tittel),
);
const nokkeltall = [
  { tall: '20+', tekst: 'års erfaring' },
  { tall: 'ca. 50', tekst: 'ansatte' },
  { tall: String(firma.stiftet), tekst: 'stiftet' },
  { tall: '4', tekst: 'lærlinger i nybygg' },
];
---
<Base
  tittel="Betongentreprenør i Bergen | Nilsen & Sture Betong AS"
  beskrivelse="Nilsen & Sture Betong – din betongentreprenør i Bergen og omegn. Betongarbeid, gulvstøp, kantstøp, nybygg og flis/mur. Over 20 års erfaring."
  jsonLd={[{ ...organisasjonLd, image: new URL(ldBilde.src, firma.url).href }, websiteLd]}
>
  <section class="hero">
    <Picture
      src={heroBilde}
      alt=""
      formats={['avif', 'webp']}
      widths={[640, 960, 1280, 1920]}
      sizes="100vw"
      quality={50}
      loading="eager"
      fetchpriority="high"
      class="hero__bilde"
    />
    <div class="beholder hero__innhold">
      <p class="overtittel">Over 20 års erfaring</p>
      <h1>Betongentreprenør i Bergen og omegn</h1>
      <p class="hero__ingress">
        Din totalleverandør av betongarbeid i Vestland. Vi utfører betongarbeid, gulvstøp, kantstøp, nybygg og flis- og
        murarbeid for privatpersoner, næringsdrivende og kommunale aktører.
      </p>
      <div class="knapperad">
        <a class="knapp knapp--lys" href={telLenke} data-cta="ring_hero_forside"><Ikon navn="telefon" />Ring {firma.telefon}</a>
        <a class="knapp knapp--omriss-lys" href="/kontakt-oss/#skjema" data-cta="tilbud_hero_forside">Gratis befaring</a>
      </div>
    </div>
  </section>

  <section class="merkestripe" aria-label="Godkjenninger">
    <div class="beholder"><Tillitsmerker /></div>
  </section>

  <section class="seksjon" id="tjenester" aria-labelledby="tjenester-tittel">
    <div class="beholder">
      <p class="overtittel">Tjenester</p>
      <h2 id="tjenester-tittel">Vi dekker alle områder innen betongarbeid</h2>
      <p class="ingress">
        Ingen jobb er for liten eller for stor. Velg tjenesten du trenger for å lese mer.
      </p>
      <Tjenestekort />
    </div>
  </section>

  <section class="seksjon seksjon--flate" aria-labelledby="hvorfor-tittel">
    <div class="beholder to-spalter">
      <div>
        <p class="overtittel">Om oss</p>
        <h2 id="hvorfor-tittel">En av Bergens ledende aktører innen betongarbeid</h2>
        <p>
          Nilsen &amp; Sture Betong ble stiftet i {firma.stiftet} og holder til i Storebotn på Askøy. Vi er {firma.ansatte}
          – erfarne forskalingssnekkere, gulvstøpere, kantstøpere, murere og flisleggere – og tar oppdrag i Bergen og omegn
          og ellers i Vestland.
        </p>
        <p>
          Vi har bred kunnskap om betong og betongarbeid, og liker en utfordring der vi finner gode løsninger sammen med
          kundene våre. Vi prioriterer tid og kvalitet, og er opptatt av å holde tidsskjemaet fra oppstart til slutt.
        </p>
        <ul class="tall">
          {nokkeltall.map((n) => <li><strong>{n.tall}</strong><span>{n.tekst}</span></li>)}
        </ul>
        <p><a href="/om-oss/">Les mer om oss</a> · <a href="/referanser/">Se referanser</a></p>
      </div>
      <div class="bildeboks">
        <Picture src={omOssBilde} alt="Prosjektmøte der tre personer går gjennom byggetegninger" formats={['avif', 'webp']} widths={[400, 640, 900]} sizes="(min-width: 60rem) 28rem, 100vw" loading="lazy" />
        <ul class="kundeliste">
          <li><strong>Private</strong> – garasje, grunnmur, gulv, bad og mur.</li>
          <li><strong>Næringsdrivende</strong> – nybygg, industri og gulv.</li>
          <li><strong>Kommuner og offentlige</strong> – vei, fortau, skoler og bygg.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="seksjon" aria-labelledby="ref-tittel">
    <div class="beholder">
      <p class="overtittel">Referanser</p>
      <h2 id="ref-tittel">Et utvalg av prosjektene våre</h2>
      <ul class="refkort rutenett rutenett--3">
        {utvalgteReferanser.map((r) => (
          <li class="kort refkort__kort">
            <Picture src={r.bilde.src} alt={r.bilde.alt} formats={['avif', 'webp']} widths={[360, 560, 720]} sizes="(min-width: 60rem) 22rem, (min-width: 40rem) 45vw, 100vw" loading="lazy" />
            <h3><a href={`/prosjekt/${r.slug}/`}>{r.tittel}</a></h3>
            <p>{r.sted}{r.betongM3 && ` · ${formatM3(r.betongM3)} betong`}</p>
          </li>
        ))}
      </ul>
      <p><a class="knapp knapp--omriss" href="/referanser/" data-cta="referanser_forside">Se alle referanser</a></p>
    </div>
  </section>

  <section class="seksjon seksjon--mork karriere" aria-labelledby="karriere-tittel">
    <div class="beholder to-spalter">
      <div>
        <p class="overtittel">Karriere</p>
        <h2 id="karriere-tittel">Vil du jobbe hos oss?</h2>
        <p>
          For å sikre høy kvalitet i alle leveranser er vi alltid på jakt etter dyktige håndverkere. Som godkjent lærebedrift
          er vi også med på å utdanne morgendagens betongarbeidere.
        </p>
        <a class="knapp knapp--lys" href="/ledige-stillinger/" data-cta="stillinger_forside">Se ledige stillinger</a>
      </div>
      <Picture src={karriereBilde} alt="Ansatt i arbeidsklær foran en firmabil fra Nilsen & Sture Betong" formats={['avif', 'webp']} widths={[400, 640, 900]} sizes="(min-width: 60rem) 28rem, 100vw" loading="lazy" class="karriere__bilde" />
    </div>
  </section>

  <section class="seksjon" aria-labelledby="kontakt-tittel">
    <div class="beholder kontaktrad">
      <div>
        <p class="overtittel">Kontakt</p>
        <h2 id="kontakt-tittel">Fortell oss hva du skal ha gjort</h2>
        <p>
          Den raskeste veien er å ringe. Du kan også sende en e-post eller bruke skjemaet, så tar vi kontakt og avtaler
          gratis befaring.
        </p>
      </div>
      <ul class="kontaktvalg">
        <li><a href={telLenke} data-cta="ring_kontakt_forside"><Ikon navn="telefon" /><span><strong>Ring</strong>{firma.telefon}</span></a></li>
        <li><a href={epostLenke} data-cta="epost_kontakt_forside"><Ikon navn="epost" /><span><strong>E-post</strong>{firma.epost}</span></a></li>
        <li><a href="/kontakt-oss/#skjema" data-cta="skjema_kontakt_forside"><Ikon navn="pil" /><span><strong>Skjema</strong>Be om tilbud</span></a></li>
      </ul>
    </div>
  </section>

  <CtaBand kilde="forside" />
</Base>

<style>
  .hero {
    position: relative;
    color: #fff;
    background: var(--farge-mork);
    border-bottom: 6px solid var(--farge-logo-rod);
    overflow: hidden;
    isolation: isolate;
  }
  .hero :global(.hero__bilde) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(100deg, rgb(35 47 54 / 0.94) 0%, rgb(35 47 54 / 0.82) 50%, rgb(35 47 54 / 0.45) 100%);
  }
  .hero__innhold {
    padding-block: clamp(3.5rem, 11vw, 8rem);
  }
  .hero h1 {
    color: #fff;
    font-size: clamp(2.3rem, 7vw, 4rem);
    max-width: 44rem;
  }
  .hero .overtittel {
    color: var(--farge-lys);
  }
  .hero__ingress {
    font-size: clamp(1.1rem, 2.5vw, 1.3rem);
    max-width: 40rem;
    color: #eef3f5;
    margin-bottom: 2rem;
  }
  .merkestripe {
    background: var(--farge-flate);
    padding: 1.25rem 0;
    border-bottom: 1px solid #e3e8eb;
  }
  .tall {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }
  @media (min-width: 40rem) {
    .tall {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .tall li {
    background: #fff;
    border-top: 4px solid var(--farge-logo-rod);
    padding: 0.8rem 1rem;
    box-shadow: var(--skygge);
  }
  .tall strong {
    display: block;
    font-family: var(--font-overskrift);
    font-size: 1.9rem;
    color: var(--farge-mork);
    line-height: 1.1;
  }
  .tall span {
    font-size: 0.95rem;
    color: var(--farge-tekst-dempet);
  }
  .bildeboks {
    display: grid;
    gap: 1.25rem;
    align-content: start;
  }
  .bildeboks :global(img) {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .kundeliste {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .kundeliste li {
    background: #fff;
    padding: 1rem 1.2rem;
    border-left: 5px solid var(--farge-aksent);
    box-shadow: var(--skygge);
  }
  .kundeliste strong {
    font-family: var(--font-overskrift);
    font-weight: 500;
    text-transform: uppercase;
    color: var(--farge-mork);
  }
  .refkort {
    list-style: none;
    padding: 0;
    margin: 0 0 1.5rem;
  }
  .refkort__kort {
    padding: 0;
    overflow: hidden;
    position: relative;
  }
  .refkort__kort h3 a {
    color: var(--farge-mork);
    text-decoration: none;
  }
  .refkort__kort h3 a::after {
    content: '';
    position: absolute;
    inset: 0;
  }
  .refkort__kort:hover h3 a {
    color: var(--farge-aksent);
  }
  .refkort__kort :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .refkort__kort h3,
  .refkort__kort p {
    padding-inline: 1.25rem;
  }
  .refkort__kort h3 {
    margin-top: 1rem;
  }
  .refkort__kort p {
    color: var(--farge-tekst-dempet);
  }
  .karriere :global(.karriere__bilde) {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--radius);
    align-self: center;
  }
  .kontaktrad {
    display: grid;
    gap: 2rem;
  }
  @media (min-width: 60rem) {
    .kontaktrad {
      grid-template-columns: 1fr 1fr;
      align-items: center;
    }
  }
  .kontaktvalg {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
  }
  .kontaktvalg a {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem;
    border: 2px solid var(--farge-lys);
    border-radius: var(--radius);
    text-decoration: none;
    color: var(--farge-tekst-2);
  }
  .kontaktvalg a:hover {
    border-color: var(--farge-aksent);
  }
  .kontaktvalg :global(svg) {
    width: 1.6rem;
    height: 1.6rem;
    color: var(--farge-aksent);
    flex: none;
  }
  .kontaktvalg span {
    display: flex;
    flex-direction: column;
  }
  .kontaktvalg strong {
    font-family: var(--font-overskrift);
    font-weight: 500;
    text-transform: uppercase;
    color: var(--farge-mork);
  }
</style>
