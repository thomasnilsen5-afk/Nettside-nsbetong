---
import Base from '../../layouts/Base.astro';
import Sidetopp from '../../components/Sidetopp.astro';
import { firma, epostLenke } from '../../data/site';
---
<Base
  tittel="Åpenhetsloven | Nilsen & Sture Betong AS"
  beskrivelse="Informasjon om hvordan Nilsen & Sture Betong AS arbeider med åpenhetsloven, og hvordan du kan be om informasjon."
  smuler={[{ navn: 'Forside', sti: '/' }, { navn: 'Åpenhetsloven', sti: '/apenhetsloven/' }]}
>
  <Sidetopp tittel="Åpenhetsloven" />
  <div class="seksjon">
    <div class="beholder prosa">
      <p>
        Åpenhetsloven skal fremme virksomheters respekt for grunnleggende menneskerettigheter og anstendige arbeidsforhold,
        og sikre allmennheten tilgang til informasjon om hvordan virksomheter håndterer negative konsekvenser for disse.
      </p>
      <h2>Redegjørelse for aktsomhetsvurderinger</h2>
      <p><span class="plassholder">[MANGLER: bedriftens redegjørelse / PDF fra dagens /apenhetsloven/]</span></p>
      <h2>Be om informasjon</h2>
      <p>
        Du kan be om informasjon om hvordan {firma.navn} håndterer faktiske og potensielle negative konsekvenser for
        grunnleggende menneskerettigheter og anstendige arbeidsforhold. Send forespørselen skriftlig til
        <a href={epostLenke}>{firma.epost}</a>.
      </p>
    </div>
  </div>
</Base>
