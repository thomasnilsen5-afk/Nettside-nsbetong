---
import Ikon from './Ikon.astro';
import { firma, telLenke } from '../data/site';
interface Props { tittel?: string; tekst?: string; kilde: string }
const {
  tittel = 'Skal du ha gjort betongarbeid?',
  tekst = 'Ring oss eller send en kort beskrivelse av oppdraget. Befaringen er gratis.',
  kilde,
} = Astro.props;
---
<section class="cta" aria-labelledby={`cta-${kilde}`}>
  <div class="beholder cta__innhold">
    <div>
      <h2 id={`cta-${kilde}`}>{tittel}</h2>
      <p>{tekst}</p>
    </div>
    <div class="knapperad">
      <a class="knapp knapp--lys" href={telLenke} data-cta={`ring_${kilde}`}><Ikon navn="telefon" />{firma.telefon}</a>
      <a class="knapp knapp--omriss-lys knapp--pil" href="/kontakt-oss/#skjema" data-cta={`tilbud_${kilde}`}>Gratis befaring<Ikon navn="pil" /></a>
    </div>
  </div>
</section>
<style>
  .cta {
    position: relative;
    overflow: hidden;
    background: var(--farge-aksent);
    color: #fff;
    padding-block: clamp(3rem, 6vw, 4.5rem);
  }
  .cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(115deg, rgb(255 255 255 / 0.04) 0 2px, transparent 2px 26px);
  }
  .cta__innhold {
    position: relative;
    display: grid;
    gap: 1.5rem;
    align-items: center;
  }
  @media (min-width: 62rem) {
    .cta__innhold {
      grid-template-columns: 1fr auto;
    }
  }
  .cta h2 {
    color: #fff;
    font-size: clamp(1.9rem, 3.6vw, 2.8rem);
    margin-bottom: 0.3em;
  }
  .cta p {
    margin: 0;
    font-size: 1.1rem;
  }
</style>
