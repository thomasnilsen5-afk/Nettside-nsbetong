---
// Bildegalleri i mosaikk. Klikk åpner bildet stort (lysboks med <dialog>); uten JS åpnes bildet direkte.
import { Picture, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props { bilder: { src: ImageMetadata; alt: string }[]; id?: string }
const { bilder, id = 'galleri' } = Astro.props;
const store = await Promise.all(bilder.map((b) => getImage({ src: b.src, width: 1800, format: 'webp', quality: 78 })));
---
<ul class:list={['galleri', `galleri--${Math.min(bilder.length, 6)}`]} data-galleri={id}>
  {bilder.map((b, i) => (
    <li data-vis style={`--i: ${i % 3}`}>
      <a href={store[i].src} data-lysboks aria-label={`Vis større: ${b.alt}`}>
        <Picture src={b.src} alt={b.alt} formats={['avif', 'webp']} widths={[480, 720, 1000]} sizes="(min-width: 62rem) 33vw, (min-width: 40rem) 50vw, 100vw" loading="lazy" />
        <span class="galleri__tekst">{b.alt}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .galleri {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.75rem;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 11rem;
  }
  @media (min-width: 48rem) {
    .galleri {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: 15rem;
    }
    /* Første bilde stort */
    .galleri li:first-child {
      grid-column: span 2;
      grid-row: span 2;
    }
    .galleri--4 li:nth-child(4) {
      grid-column: span 3;
    }
    .galleri--6 li:nth-child(6) {
      grid-column: span 2;
    }
  }
  @media (max-width: 47.99rem) {
    .galleri li:first-child {
      grid-column: span 2;
      grid-row: span 2;
    }
  }
  .galleri a {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius);
    background: var(--farge-mork);
    cursor: zoom-in;
  }
  .galleri :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.8s var(--ease),
      opacity 0.3s;
  }
  .galleri a:hover :global(img) {
    transform: scale(1.05);
    opacity: 0.85;
  }
  .galleri__tekst {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2rem 1rem 0.8rem;
    color: #fff;
    font-size: 0.92rem;
    line-height: 1.4;
    background: linear-gradient(0deg, rgb(10 14 16 / 0.85), rgb(10 14 16 / 0));
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.3s,
      transform 0.3s var(--ease);
  }
  .galleri a:hover .galleri__tekst,
  .galleri a:focus-visible .galleri__tekst {
    opacity: 1;
    transform: none;
  }
  @media (hover: none) {
    .galleri__tekst {
      opacity: 1;
      transform: none;
    }
  }
</style>
