---
import { firma } from '../data/site';
// Bruker bedriftens egen logo (NS.svg fra dagens side) når den er lagt inn i /public/img/.
// Til da vises firmanavnet som tekst – logoen skal IKKE tegnes på nytt.
interface Props { lys?: boolean }
const { lys = false } = Astro.props;
---
<a href="/" class:list={['logo', { 'logo--lys': lys }]} aria-label={`${firma.navn} – til forsiden`}>
  {firma.logoTilgjengelig ? (
    <img src={firma.logo} alt={firma.navn} width="160" height="56" />
  ) : (
    <span class="logo__tekst" aria-hidden="true">
      <span class="logo__navn">Nilsen &amp; Sture</span>
      <span class="logo__sub">Betong AS</span>
    </span>
  )}
</a>
<style>
  .logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--farge-mork);
    min-height: 48px;
  }
  .logo img {
    height: 48px;
    width: auto;
  }
  .logo__tekst {
    display: flex;
    flex-direction: column;
    line-height: 1;
    font-family: var(--font-overskrift);
    text-transform: uppercase;
    border-left: 5px solid var(--farge-logo-rod);
    padding-left: 0.6rem;
  }
  .logo__navn {
    font-weight: 600;
    font-size: 1.35rem;
    letter-spacing: 0.02em;
  }
  .logo__sub {
    font-weight: 500;
    font-size: 0.85rem;
    letter-spacing: 0.22em;
    color: var(--farge-aksent);
    margin-top: 0.2rem;
  }
  .logo--lys {
    color: #fff;
  }
  .logo--lys .logo__sub {
    color: var(--farge-lys);
  }
</style>
