---
import { firma } from '../data/site';
// Bedriftens egen logo (NS.svg, hentet uendret fra dagens side) + firmanavnet som tekst.
interface Props { lys?: boolean; stor?: boolean }
const { lys = false, stor = false } = Astro.props;
---
<a href="/" class:list={['logo', { 'logo--lys': lys, 'logo--stor': stor }]} aria-label={`${firma.navn} – til forsiden`}>
  <img src={firma.logo} alt="" width="54" height="54" />
  <span class="logo__tekst" aria-hidden="true">
    <span class="logo__navn">Nilsen &amp; Sture</span>
    <span class="logo__sub">Betong AS</span>
  </span>
</a>
<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    text-decoration: none;
    color: var(--farge-mork);
    min-height: 48px;
    flex: none;
  }
  .logo img {
    width: 3.1rem;
    height: 3.1rem;
    flex: none;
    filter: drop-shadow(0 2px 6px rgb(0 0 0 / 0.25));
  }
  .logo__tekst {
    display: flex;
    flex-direction: column;
    line-height: 1;
    font-family: var(--font-overskrift);
    text-transform: uppercase;
  }
  .logo__navn {
    font-weight: 600;
    font-size: 1.3rem;
    letter-spacing: 0.03em;
  }
  .logo__sub {
    font-weight: 500;
    font-size: 0.78rem;
    letter-spacing: 0.34em;
    margin-top: 0.3rem;
    color: var(--farge-aksent);
  }
  .logo--lys,
  .logo--lys:hover {
    color: #fff;
  }
  .logo--lys .logo__sub {
    color: var(--farge-lys);
  }
  .logo--stor img {
    width: 4.5rem;
    height: 4.5rem;
  }
  .logo--stor .logo__navn {
    font-size: 1.7rem;
  }
</style>
