---
import { firma } from '../data/site';
// Bedriftens egen logo (NS.svg hentet fra dagens side) + firmanavnet som tekst ved siden av.
interface Props { lys?: boolean }
const { lys = false } = Astro.props;
---
<a href="/" class:list={['logo', { 'logo--lys': lys }]} aria-label={`${firma.navn} – til forsiden`}>
  {firma.logoTilgjengelig && <img src={firma.logo} alt="" width="52" height="52" />}
  <span class="logo__tekst" aria-hidden="true">
    <span class="logo__navn">Nilsen &amp; Sture</span>
    <span class="logo__sub">Betong AS</span>
  </span>
</a>
<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    text-decoration: none;
    color: var(--farge-mork);
    min-height: 48px;
  }
  .logo img {
    width: 52px;
    height: 52px;
    flex: none;
  }
  .logo__tekst {
    display: flex;
    flex-direction: column;
    line-height: 1;
    font-family: var(--font-overskrift);
    text-transform: uppercase;
  }
  .logo__navn {
    font-weight: 600;
    font-size: 1.3rem;
    letter-spacing: 0.02em;
  }
  .logo__sub {
    font-weight: 500;
    font-size: 0.8rem;
    letter-spacing: 0.24em;
    color: var(--farge-aksent);
    margin-top: 0.25rem;
  }
  .logo--lys {
    color: #fff;
  }
  .logo--lys .logo__sub {
    color: var(--farge-lys);
  }
</style>
