---
import { Picture } from 'astro:assets';
import Ikon from './Ikon.astro';
import { tjenester } from '../data/tjenester';
interface Props { utvalg?: string[]; overskriftNivaa?: 'h2' | 'h3' }
const { utvalg, overskriftNivaa = 'h3' } = Astro.props;
const liste = utvalg ? tjenester.filter((t) => utvalg.includes(t.slug)) : tjenester;
const H = overskriftNivaa;
---
<ul class="tkort rutenett rutenett--3">
  {liste.map((t) => (
    <li class="tkort__kort">
      <Picture
        src={t.hero.src}
        alt=""
        formats={['avif', 'webp']}
        widths={[360, 560, 720]}
        sizes="(min-width: 60rem) 22rem, (min-width: 40rem) 45vw, 100vw"
        loading="lazy"
        class="tkort__bilde"
      />
      <div class="tkort__innhold">
        <H class="tkort__tittel"><a href={`/${t.slug}/`}>{t.navn}</a></H>
        <p>{t.kort}</p>
        <span class="tkort__mer" aria-hidden="true">Les mer <Ikon navn="pil" /></span>
      </div>
    </li>
  ))}
</ul>
<style>
  .tkort {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .tkort__kort {
    position: relative;
    background: #fff;
    border: 1px solid #dfe5e8;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--skygge);
    display: flex;
    flex-direction: column;
  }
  .tkort__kort :global(img) {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    transition: transform 0.3s;
  }
  .tkort__kort:hover :global(img) {
    transform: scale(1.03);
  }
  .tkort__innhold {
    border-top: 4px solid var(--farge-mork);
    padding: 1.25rem 1.5rem 1.5rem;
    display: flex;
    flex-direction: column;
    flex: 1;
    background: #fff;
  }
  .tkort__kort:hover .tkort__innhold,
  .tkort__kort:focus-within .tkort__innhold {
    border-top-color: var(--farge-logo-rod);
  }
  .tkort__tittel {
    font-size: 1.4rem;
    margin-bottom: 0.4rem;
  }
  .tkort__tittel a {
    color: var(--farge-mork);
    text-decoration: none;
  }
  .tkort__tittel a::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
  }
  .tkort__innhold p {
    flex: 1;
  }
  .tkort__mer {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    color: var(--farge-aksent);
    font-weight: 600;
  }
  .tkort__mer :global(svg) {
    width: 1rem;
    height: 1rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .tkort__kort :global(img) {
      transition: none;
    }
  }
</style>
