---
import Ikon from './Ikon.astro';
import type { Faq } from '../data/tjenester';
interface Props { sporsmal: Faq[]; tittel?: string }
const { sporsmal, tittel = 'Ofte stilte spørsmål' } = Astro.props;
---
<div class="faq">
  <h2 id="faq-tittel">{tittel}</h2>
  {sporsmal.map((f, i) => (
    <details class="faq__punkt" open={i === 0}>
      <summary>
        <h3>{f.sporsmal}</h3>
        <span class="faq__ikon" aria-hidden="true"><Ikon navn="pluss" /></span>
      </summary>
      <div class="faq__svar"><p>{f.svar}</p></div>
    </details>
  ))}
</div>
<style>
  .faq h2 {
    margin-bottom: 1.5rem;
  }
  .faq__punkt {
    border-top: 1px solid var(--farge-linje);
  }
  .faq__punkt:last-child {
    border-bottom: 1px solid var(--farge-linje);
  }
  .faq__punkt summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1.5rem;
    padding: 1.25rem 0;
  }
  .faq__punkt summary::-webkit-details-marker {
    display: none;
  }
  .faq__punkt h3 {
    margin: 0;
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    transition: color 0.15s;
  }
  .faq__punkt summary:hover h3 {
    color: var(--farge-aksent);
  }
  .faq__ikon {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    border: 1px solid var(--farge-linje);
    color: var(--farge-aksent);
    transition:
      transform 0.3s var(--ease),
      background-color 0.2s;
  }
  .faq__punkt[open] .faq__ikon {
    transform: rotate(45deg);
    background: var(--farge-aksent);
    border-color: var(--farge-aksent);
    color: #fff;
  }
  .faq__svar {
    padding: 0 3.5rem 1.25rem 0;
  }
  .faq__svar p {
    margin: 0;
    color: var(--farge-tekst-dempet);
  }
</style>
