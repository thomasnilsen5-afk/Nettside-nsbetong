---
import Ikon from './Ikon.astro';
import { telLenke } from '../data/site';
---
<div class="mobilcta">
  <a class="mobilcta__ring" href={telLenke} data-cta="ring_mobilfelt"><Ikon navn="telefon" />Ring oss</a>
  <a class="mobilcta__tilbud" href="/kontakt-oss/#skjema" data-cta="tilbud_mobilfelt">Be om tilbud</a>
</div>
<style>
  :global(:root) {
    --mobil-cta-hoyde: 64px;
  }
  .mobilcta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 50;
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: calc(var(--mobil-cta-hoyde) + env(safe-area-inset-bottom));
    padding-bottom: env(safe-area-inset-bottom);
    box-shadow: 0 -2px 12px rgb(0 0 0 / 0.2);
  }
  .mobilcta a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    font-family: var(--font-overskrift);
    font-weight: 500;
    font-size: 1.15rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    text-decoration: none;
  }
  .mobilcta :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }
  .mobilcta__ring {
    background: var(--farge-aksent);
    color: #fff;
  }
  .mobilcta__tilbud {
    background: var(--farge-mork);
    color: #fff;
  }
  .mobilcta a:hover {
    color: #fff;
    filter: brightness(0.9);
  }
  @media (min-width: 64rem) {
    :global(:root) {
      --mobil-cta-hoyde: 0px;
    }
    .mobilcta {
      display: none;
    }
  }
</style>
