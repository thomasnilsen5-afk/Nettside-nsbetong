---
import Ikon from './Ikon.astro';
import { telLenke } from '../data/site';
---
<div class="mobilcta">
  <a class="mobilcta__ring" href={telLenke} data-cta="ring_mobilfelt"><Ikon navn="telefon" />Ring oss</a>
  <a class="mobilcta__tilbud" href="/kontakt-oss/#skjema" data-cta="tilbud_mobilfelt"><Ikon navn="befaring" />Gratis befaring</a>
</div>
<style>
  :global(:root) {
    --mobil-cta-hoyde: 62px;
  }
  .mobilcta {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 40;
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: calc(var(--mobil-cta-hoyde) + env(safe-area-inset-bottom));
    padding-bottom: env(safe-area-inset-bottom);
    background: var(--farge-mork-2);
    box-shadow: 0 -4px 18px rgb(0 0 0 / 0.25);
  }
  .mobilcta a {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    font-family: var(--font-overskrift);
    font-weight: 500;
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    text-decoration: none;
    color: #fff;
  }
  .mobilcta :global(.ikon) {
    width: 1.3rem;
    height: 1.3rem;
  }
  .mobilcta__ring {
    background: var(--farge-aksent);
  }
  .mobilcta a:hover {
    color: #fff;
    filter: brightness(1.1);
  }
  @media (min-width: 68rem) {
    :global(:root) {
      --mobil-cta-hoyde: 0px;
    }
    .mobilcta {
      display: none;
    }
  }
</style>
