---
import { tillitsmerker } from '../data/site';
interface Props { visTekst?: boolean }
const { visTekst = false } = Astro.props;
---
<ul class:list={['merker', { 'merker--tekst': visTekst }]}>
  {tillitsmerker.map((m) => (
    <li>
      <strong>{m.navn}</strong>
      {visTekst && <span>{m.tekst}</span>}
    </li>
  ))}
</ul>
<style>
  .merker {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .merker li {
    display: flex;
    flex-direction: column;
    border: 2px solid var(--farge-lys);
    border-left: 5px solid var(--farge-aksent);
    background: #fff;
    padding: 0.5rem 0.9rem;
    border-radius: var(--radius);
    color: var(--farge-mork);
  }
  .merker strong {
    font-family: var(--font-overskrift);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .merker--tekst {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
  }
  .merker--tekst span {
    font-size: 0.95rem;
    color: var(--farge-tekst-dempet);
  }
</style>
