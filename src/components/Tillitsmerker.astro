---
import { Image } from 'astro:assets';
import Ikon from './Ikon.astro';
import { tillitsmerker } from '../data/site';
interface Props { visTekst?: boolean }
const { visTekst = false } = Astro.props;
---
<ul class:list={['merker', { 'merker--tekst': visTekst }]}>
  {tillitsmerker.map((m, i) => (
    <li data-vis style={`--i: ${i}`}>
      {m.logo ? (
        <Image src={m.logo} alt={m.logoAlt ?? m.navn} height={80} densities={[1, 2]} loading="lazy" class="merker__logo" />
      ) : (
        <Ikon navn={m.navn.includes('lære') ? 'laerling' : 'dusj'} klasse="merker__ikon" />
      )}
      <span class="merker__tekst">
        <strong class:list={{ 'visuelt-skjult': m.logo && !visTekst }}>{m.navn}</strong>
        {visTekst && <span>{m.tekst}</span>}
      </span>
    </li>
  ))}
</ul>
<style>
  .merker {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    align-items: stretch;
    gap: 0.75rem;
  }
  .merker li {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    background: #fff;
    border: 1px solid var(--farge-linje);
    border-radius: var(--radius);
    padding: 0.6rem 1.1rem;
    min-height: 5.5rem;
    color: var(--farge-mork);
  }
  .merker :global(.merker__logo) {
    height: 4.25rem;
    width: auto;
  }
  .merker :global(.merker__ikon) {
    width: 2.4rem;
    height: 2.4rem;
    padding: 0.45rem;
    border-radius: 50%;
    background: var(--farge-aksent);
    color: #fff;
  }
  .merker__tekst {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .merker strong {
    font-family: var(--font-overskrift);
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.98rem;
  }
  .merker--tekst {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .merker--tekst .merker__tekst span {
    font-size: 0.92rem;
    color: var(--farge-tekst-dempet);
  }
</style>
