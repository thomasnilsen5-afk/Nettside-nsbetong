---
import { hovedmeny, tjenesteLenker } from '../data/site';
interface Props { sti: string }
const { sti } = Astro.props;
const erAktiv = (href: string) => !href.includes('#') && sti.startsWith(href);
const iTjenester = tjenesteLenker.some((t) => sti.startsWith(t.href));
---
<ul class="menyliste">
  <li class="menyliste__gruppe">
    <a href="/#tjenester" class:list={['menyliste__gruppetittel', { aktiv: iTjenester }]}>Tjenester</a>
    <ul>
      {tjenesteLenker.map((t) => (
        <li><a href={t.href} aria-current={sti === t.href ? 'page' : undefined}>{t.tekst}</a></li>
      ))}
    </ul>
  </li>
  {hovedmeny.filter((m) => m.tekst !== 'Tjenester').map((m) => (
    <li><a href={m.href} class:list={{ aktiv: erAktiv(m.href) }} aria-current={sti === m.href ? 'page' : undefined}>{m.tekst}</a></li>
  ))}
</ul>
