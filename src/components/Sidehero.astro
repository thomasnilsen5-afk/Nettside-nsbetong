---
// Toppbilde for undersider: fullbredde foto med mørk toning, brødsmuler, H1 og ingress.
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Brodsmuler, { type Smule } from './Brodsmuler.astro';

interface Props {
  tittel: string;
  overtittel?: string;
  ingress?: string;
  bilde?: ImageMetadata;
  smuler?: Smule[];
  storrelse?: 'stor' | 'middels' | 'liten';
  posisjon?: string; // object-position for bildet
}
const { tittel, overtittel, ingress, bilde, smuler, storrelse = 'middels', posisjon = 'center' } = Astro.props;
---
<section class:list={['sidehero', `sidehero--${storrelse}`, { 'sidehero--uten-bilde': !bilde }]}>
  {bilde && (
    <Picture
      src={bilde}
      alt=""
      formats={['avif', 'webp']}
      widths={[480, 768, 1024, 1440, 1920]}
      sizes="100vw"
      quality={45}
      loading="eager"
      fetchpriority="high"
      class="sidehero__bilde"
      style={`object-position: ${posisjon}`}
    />
  )}
  <div class="beholder sidehero__innhold">
    {smuler && smuler.length > 1 && <Brodsmuler smuler={smuler} />}
    {overtittel && <p class="overtittel">{overtittel}</p>}
    <h1>{tittel}</h1>
    {ingress && <p class="ingress">{ingress}</p>}
    <slot />
  </div>
</section>

<style>
  .sidehero {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    color: #fff;
    background: var(--farge-mork-2);
    overflow: hidden;
    padding-top: calc(var(--topp-hoyde) + 2rem);
  }
  .sidehero--stor {
    min-height: min(88svh, 52rem);
  }
  .sidehero--middels {
    min-height: min(68svh, 40rem);
  }
  .sidehero--liten {
    min-height: 22rem;
  }
  .sidehero :global(.sidehero__bilde) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }
  .sidehero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(0deg, rgb(15 21 24 / 0.92) 0%, rgb(15 21 24 / 0.55) 45%, rgb(15 21 24 / 0.35) 100%),
      linear-gradient(90deg, rgb(15 21 24 / 0.6) 0%, rgb(15 21 24 / 0) 70%);
  }
  .sidehero--uten-bilde::before {
    background:
      linear-gradient(rgb(26 35 40 / 0.93), rgb(26 35 40 / 0.93)),
      var(--betong, none) center / cover;
  }
  .sidehero::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    width: min(38%, 26rem);
    height: 6px;
    background: var(--farge-logo-rod);
  }
  .sidehero__innhold {
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .sidehero h1 {
    color: #fff;
    max-width: 22ch;
    margin-bottom: 0.4em;
  }
  .sidehero--liten h1 {
    font-size: clamp(2.3rem, 5.5vw, 4rem);
  }
  .sidehero .ingress {
    margin-bottom: 1.75rem;
  }
  .sidehero a:not(.knapp) {
    color: #fff;
  }
</style>
