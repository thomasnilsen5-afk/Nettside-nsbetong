---
// Stort rødt bånd med nøkkeltall (prosjektfakta, selskapsfakta).
import Ikon, { type IkonNavn } from './Ikon.astro';
export type Fakta = { verdi: string; etikett: string; ikon?: IkonNavn };
interface Props { fakta: Fakta[]; tittel?: string; mork?: boolean }
const { fakta, tittel, mork = false } = Astro.props;
---
<section class:list={['faktaband', { 'faktaband--mork': mork }]} aria-label={tittel ?? 'Nøkkeltall'}>
  <div class="beholder">
    {tittel && <p class="faktaband__tittel">{tittel}</p>}
    <dl class="faktaband__liste" style={`--antall: ${fakta.length}`}>
      {fakta.map((f, i) => (
        <div data-vis style={`--i: ${i}`}>
          {f.ikon && <Ikon navn={f.ikon} klasse="faktaband__ikon" />}
          <dd>{f.verdi}</dd>
          <dt>{f.etikett}</dt>
        </div>
      ))}
    </dl>
  </div>
</section>
<style>
  .faktaband {
    background: var(--farge-aksent);
    color: #fff;
    padding-block: clamp(2.5rem, 5vw, 4rem);
    position: relative;
    overflow: hidden;
  }
  .faktaband::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(115deg, rgb(255 255 255 / 0.035) 0 2px, transparent 2px 26px);
    pointer-events: none;
  }
  .faktaband--mork {
    background: var(--farge-mork);
  }
  .faktaband__tittel {
    font-family: var(--font-overskrift);
    text-transform: uppercase;
    letter-spacing: 0.18em;
    font-size: 0.95rem;
    text-align: center;
    margin-bottom: 2rem;
    opacity: 0.9;
  }
  .faktaband__liste {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 1.5rem;
    margin: 0;
    position: relative;
  }
  @media (min-width: 56rem) {
    .faktaband__liste {
      grid-template-columns: repeat(var(--antall), 1fr);
    }
    .faktaband__liste > div + div {
      border-left: 1px solid rgb(255 255 255 / 0.25);
    }
  }
  .faktaband__liste > div {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding-inline: 0.5rem;
  }
  .faktaband dd {
    order: 2;
    margin: 0;
    font-family: var(--font-overskrift);
    font-weight: 600;
    font-size: clamp(1.9rem, 4.2vw, 3.2rem);
    line-height: 1.05;
    font-variant-numeric: tabular-nums;
  }
  .faktaband dt {
    order: 3;
    margin-top: 0.35rem;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    opacity: 0.92;
  }
  .faktaband :global(.faktaband__ikon) {
    order: 1;
    width: 1.8rem;
    height: 1.8rem;
    margin-bottom: 0.5rem;
    opacity: 0.85;
  }
</style>
