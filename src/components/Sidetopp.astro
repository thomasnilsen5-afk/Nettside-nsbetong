---
interface Props { overtittel?: string; tittel: string; ingress?: string }
const { overtittel, tittel, ingress } = Astro.props;
---
<section class="sidetopp">
  <div class="beholder">
    {overtittel && <p class="overtittel">{overtittel}</p>}
    <h1>{tittel}</h1>
    {ingress && <p class="ingress">{ingress}</p>}
    <slot />
  </div>
</section>
<style>
  .sidetopp {
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0) 0, #fff 100%),
      repeating-linear-gradient(135deg, #eef2f4 0 2px, transparent 2px 14px),
      var(--farge-flate);
    padding: 2rem 0 2.5rem;
    border-bottom: 1px solid #e3e8eb;
  }
</style>
