---
// Inline SVG-ikoner fra Material Design Icons (@mdi/js, Pictogrammers Free License).
// Ingen ikonfont og ingen ekstra forespørsler – bare ikonene som faktisk brukes havner i HTML-en.
import * as mdi from '@mdi/js';

const ikoner = {
  telefon: mdi.mdiPhone,
  epost: mdi.mdiEmailOutline,
  kart: mdi.mdiMapMarkerOutline,
  facebook: mdi.mdiFacebook,
  pil: mdi.mdiArrowRight,
  pilVenstre: mdi.mdiArrowLeft,
  pilOpp: mdi.mdiArrowTopRight,
  meny: mdi.mdiMenu,
  lukk: mdi.mdiClose,
  ned: mdi.mdiChevronDown,
  venstre: mdi.mdiChevronLeft,
  hoyre: mdi.mdiChevronRight,
  pluss: mdi.mdiPlus,
  hjelm: mdi.mdiHardHat,
  pris: mdi.mdiCashMultiple,
  levering: mdi.mdiTruckFastOutline,
  team: mdi.mdiAccountGroupOutline,
  samarbeid: mdi.mdiHandshakeOutline,
  kvalitet: mdi.mdiShieldCheckOutline,
  kalender: mdi.mdiCalendarRange,
  betong: mdi.mdiCube,
  areal: mdi.mdiFloorPlan,
  bygg: mdi.mdiOfficeBuildingOutline,
  dokument: mdi.mdiFileDocumentOutline,
  befaring: mdi.mdiMagnify,
  sjekkliste: mdi.mdiClipboardCheckOutline,
  arbeider: mdi.mdiAccountHardHat,
  laerling: mdi.mdiSchoolOutline,
  hake: mdi.mdiCheck,
  kontrakt: mdi.mdiCashCheck,
  sted: mdi.mdiMapMarkerRadiusOutline,
  linjal: mdi.mdiRuler,
  dusj: mdi.mdiShower,
  vei: mdi.mdiRoadVariant,
  mur: mdi.mdiWall,
  bolig: mdi.mdiHomeCityOutline,
  lag: mdi.mdiLayersTripleOutline,
  send: mdi.mdiEmailFastOutline,
  klokke: mdi.mdiClockOutline,
  forstorr: mdi.mdiArrowExpand,
} as const;

export type IkonNavn = keyof typeof ikoner;

interface Props {
  navn: IkonNavn;
  klasse?: string;
}
const { navn, klasse } = Astro.props;
---
<svg class:list={['ikon', klasse]} viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d={ikoner[navn]} /></svg>
