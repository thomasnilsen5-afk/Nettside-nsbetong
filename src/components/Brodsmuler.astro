---
// Brødsmuler vises inne i sidens toppbilde (lys tekst). JSON-LD lages i Base.astro.
export type Smule = { navn: string; sti: string };
interface Props { smuler: Smule[] }
const { smuler } = Astro.props;
---
<nav class="smuler" aria-label="Brødsmuler">
  <ol>
    {smuler.map((s, i) => (
      <li>
        {i < smuler.length - 1 ? <a href={s.sti}>{s.navn}</a> : <span aria-current="page">{s.navn}</span>}
      </li>
    ))}
  </ol>
</nav>
<style>
  .smuler ol {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    margin: 0 0 1.5rem;
    padding: 0;
    font-size: 0.88rem;
    letter-spacing: 0.04em;
    color: rgb(255 255 255 / 0.85);
  }
  .smuler li:not(:last-child)::after {
    content: '/';
    margin: 0 0.6rem;
    color: rgb(255 255 255 / 0.5);
  }
  .smuler a {
    color: #fff;
    text-decoration: none;
  }
  .smuler a:hover {
    text-decoration: underline;
  }
</style>
