---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobilCta from '../components/MobilCta.astro';
import Samtykke from '../components/Samtykke.astro';
import DemoBanner from '../components/DemoBanner.astro';
import Brodsmuler, { type Smule } from '../components/Brodsmuler.astro';
import { firma } from '../data/site';
import { miljo } from '../data/miljo';

interface Props {
  tittel: string;
  beskrivelse: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  smuler?: Smule[];
  ogBilde?: string;
  ogType?: 'website' | 'article';
}

const { tittel, beskrivelse, noindex = false, jsonLd = [], smuler, ogBilde = '/img/og-nsbetong.jpg', ogType = 'website' } =
  Astro.props;

const sti = Astro.url.pathname;
const kanonisk = new URL(sti, firma.url).href;
const ogBildeUrl = new URL(ogBilde, firma.url).href;
const robots = noindex || miljo.noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large';
const sporing = Boolean(miljo.gtmId || miljo.ga4Id);

// BreadcrumbList genereres automatisk fra brødsmulene.
const ld = [...jsonLd];
if (smuler && smuler.length > 1) {
  ld.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: smuler.map((s, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: s.navn,
      item: new URL(s.sti, firma.url).href,
    })),
  });
}

const konfig = { gtm: miljo.gtmId, ga4: miljo.ga4Id, demo: miljo.demo };
---
<!doctype html>
<html lang="nb">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tittel}</title>
    <meta name="description" content={beskrivelse} />
    <link rel="canonical" href={kanonisk} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#232F36" />
    <meta name="format-detection" content="telephone=no" />
    {miljo.gscVerifisering && <meta name="google-site-verification" content={miljo.gscVerifisering} />}

    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="nb_NO" />
    <meta property="og:site_name" content={firma.navn} />
    <meta property="og:title" content={tittel} />
    <meta property="og:description" content={beskrivelse} />
    <meta property="og:url" content={kanonisk} />
    <meta property="og:image" content={ogBildeUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <link rel="preload" href="/fonts/oswald-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/oswald-latin-500-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/work-sans-latin-400-normal.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/work-sans-latin-600-normal.woff2" as="font" type="font/woff2" crossorigin />

    <!-- Consent Mode v2: alt avslått som standard. Ingen tredjepartsskript lastes før samtykke. -->
    <script is:inline define:vars={{ konfig }}>
      window.NSB = konfig;
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      window.gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        functionality_storage: 'granted',
        security_storage: 'granted',
        wait_for_update: 500,
      });
      window.gtag('set', 'ads_data_redaction', true);
      window.gtag('set', 'url_passthrough', false);
    </script>

    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
  </head>
  <body>
    <a class="hopp-lenke" href="#hovedinnhold">Hopp til hovedinnhold</a>
    {miljo.demo && <DemoBanner />}
    <Header sti={sti} />
    {smuler && smuler.length > 1 && <Brodsmuler smuler={smuler} />}
    <main id="hovedinnhold">
      <slot />
    </main>
    <Footer />
    <MobilCta />
    {sporing && <Samtykke />}
    <script>
      import '../scripts/nsb.ts';
    </script>
  </body>
</html>
