---
import { Picture, Image } from 'astro:assets';
import Base from './Base.astro';
import CtaBand from '../components/CtaBand.astro';
import Faq from '../components/Faq.astro';
import Ikon from '../components/Ikon.astro';
import Tjenestekort from '../components/Tjenestekort.astro';
import Tillitsmerker from '../components/Tillitsmerker.astro';
import { tjenesteEtterSlug } from '../data/tjenester';
import { firma, telLenke } from '../data/site';
import { omraaderLd } from '../data/jsonld';

interface Props { slug: string }
const t = tjenesteEtterSlug(Astro.props.slug);
const url = `${firma.url}/${t.slug}/`;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${url}#tjeneste`,
    name: t.navn,
    serviceType: t.serviceType,
    description: t.beskrivelse,
    url,
    provider: { '@id': `${firma.url}/#firma` },
    areaServed: omraaderLd,
  },
];
---
<Base
  tittel={t.tittel}
  beskrivelse={t.beskrivelse}
  jsonLd={jsonLd}
  smuler={[{ navn: 'Forside', sti: '/' }, { navn: t.navn, sti: `/${t.slug}/` }]}
  ogBilde={t.hero.src}
>
  <section class="thero">
    <div class="beholder thero__rad">
      <div class="thero__tekst">
        <p class="overtittel">Tjeneste</p>
        <h1>{t.h1}</h1>
        <p class="ingress">{t.ingress}</p>
        {t.fakta && <p class="thero__fakta">{t.fakta}</p>}
        <div class="knapperad">
          <a class="knapp" href={telLenke} data-cta={`ring_hero_${t.slug}`}><Ikon navn="telefon" />Ring {firma.telefon}</a>
          <a class="knapp knapp--omriss" href={`/kontakt-oss/?tjeneste=${t.slug}#skjema`} data-cta={`tilbud_hero_${t.slug}`}>Gratis befaring</a>
        </div>
      </div>
      <Picture
        src={t.hero.src}
        alt={t.hero.alt}
        formats={['avif', 'webp']}
        widths={[480, 720, 960, 1280]}
        sizes="(min-width: 72rem) 34rem, (min-width: 60rem) 45vw, 100vw"
        loading="eager"
        fetchpriority="high"
        class="thero__bilde"
      />
    </div>
  </section>

  <div class="seksjon">
    <div class="beholder to-spalter">
      <div class="prosa">
        {t.intro.map((p) => <p>{p}</p>)}

        <h2>{t.inngaarTittel}</h2>
        <ul class="hakeliste hakeliste--to">{t.inngaar.map((x) => <li>{x}</li>)}</ul>

        {t.former && (
          <section class="former" aria-labelledby="former-tittel">
            <h2 id="former-tittel">{t.former.tittel}</h2>
            <p>{t.former.tekst}</p>
            <div class="former__liste">
              {t.former.bilder.map((b) => (
                <figure>
                  <Image src={b.src} alt={b.alt} widths={[400, 800]} sizes="(min-width: 60rem) 40rem, 100vw" loading="lazy" />
                </figure>
              ))}
            </div>
          </section>
        )}

        <h2>Typiske oppdrag</h2>
        <ul class="hakeliste">{t.oppdrag.map((x) => <li>{x}</li>)}</ul>

        <h2>Hvem passer det for?</h2>
        <ul class="hakeliste">{t.passerFor.map((x) => <li>{x}</li>)}</ul>
      </div>

      <aside class="sidekolonne" aria-label="Kontakt og fordeler">
        <div class="kort sidekort">
          <h2 class="sidekort__tittel">Gratis befaring</h2>
          <p>Ring oss direkte eller send en kort beskrivelse, så tar vi kontakt.</p>
          <a class="knapp sidekort__knapp" href={telLenke} data-cta={`ring_side_${t.slug}`}><Ikon navn="telefon" />{firma.telefon}</a>
          <a class="knapp knapp--omriss sidekort__knapp" href={`/kontakt-oss/?tjeneste=${t.slug}#skjema`} data-cta={`tilbud_side_${t.slug}`}>Send forespørsel</a>
        </div>
        <div class="kort">
          <h2 class="sidekort__tittel">Hvorfor velge oss?</h2>
          <ul class="hakeliste">{t.hvorfor.map((x) => <li>{x}</li>)}</ul>
        </div>
      </aside>
    </div>
  </div>

  {t.bilder.length > 0 && (
    <section class="seksjon seksjon--flate" aria-labelledby="bilder-tittel">
      <div class="beholder">
        <h2 id="bilder-tittel">Fra våre prosjekter</h2>
        <ul class="galleri">
          {t.bilder.map((b) => (
            <li>
              <figure>
                <Picture src={b.src} alt={b.alt} formats={['avif', 'webp']} widths={[400, 640, 900]} sizes="(min-width: 60rem) 23rem, (min-width: 40rem) 48vw, 100vw" loading="lazy" />
                <figcaption>{b.alt}</figcaption>
              </figure>
            </li>
          ))}
        </ul>
        <p class="galleri__lenke"><a href="/referanser/">Se referanseprosjektene våre <Ikon navn="pil" /></a></p>
      </div>
    </section>
  )}

  <div class="seksjon">
    <div class="beholder to-spalter">
      <div class="prosa"><Faq sporsmal={t.faq} /></div>
      <div>
        <h2 class="sidekort__tittel">Godkjenninger</h2>
        <Tillitsmerker />
      </div>
    </div>
  </div>

  <section class="seksjon seksjon--flate" aria-labelledby="andre-tjenester">
    <div class="beholder">
      <h2 id="andre-tjenester">Andre tjenester</h2>
      <Tjenestekort utvalg={t.relaterte} />
    </div>
  </section>

  <CtaBand kilde={t.slug} tittel={`Trenger du hjelp med ${t.kortnavn.toLowerCase()}?`} />
</Base>

<style>
  .thero {
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0) 0, #fff 100%),
      repeating-linear-gradient(135deg, #eef2f4 0 2px, transparent 2px 14px),
      var(--farge-flate);
    padding: 1.5rem 0 2.5rem;
    border-bottom: 1px solid #e3e8eb;
  }
  .thero__rad {
    display: grid;
    gap: 1.75rem;
    align-items: center;
  }
  @media (min-width: 60rem) {
    .thero__rad {
      grid-template-columns: 1.1fr 1fr;
      gap: 3rem;
    }
  }
  .thero__rad :global(.thero__bilde) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius);
    box-shadow: 0 10px 30px rgb(35 47 54 / 0.18);
    border-bottom: 6px solid var(--farge-logo-rod);
  }
  .thero__fakta {
    font-weight: 600;
    color: var(--farge-mork);
    border-left: 4px solid var(--farge-logo-rod);
    padding-left: 0.75rem;
  }
  .hakeliste--to {
    columns: 2 14rem;
    column-gap: 2rem;
  }
  .hakeliste--to li {
    break-inside: avoid;
  }
  .former__liste {
    display: grid;
    gap: 1rem;
  }
  .former figure {
    margin: 0;
    background: #fff;
    border: 1px solid #dfe5e8;
    border-radius: var(--radius);
    padding: 0.75rem;
  }
  .sidekolonne {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }
  @media (min-width: 60rem) {
    .sidekolonne {
      position: sticky;
      top: 1.5rem;
    }
  }
  .sidekort {
    border-top: 5px solid var(--farge-aksent);
  }
  .sidekort__tittel {
    font-size: 1.35rem;
  }
  .sidekort__knapp {
    width: 100%;
    margin-top: 0.6rem;
  }
  .galleri {
    list-style: none;
    padding: 0;
    margin: 0 0 1rem;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
  }
  .galleri figure {
    margin: 0;
    background: #fff;
    border-radius: var(--radius);
    overflow: hidden;
    box-shadow: var(--skygge);
    height: 100%;
  }
  .galleri :global(img) {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .galleri figcaption {
    padding: 0.6rem 0.9rem;
    font-size: 0.95rem;
    color: var(--farge-tekst-dempet);
  }
  .galleri__lenke a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
  }
  .galleri__lenke :global(svg) {
    width: 1rem;
    height: 1rem;
  }
</style>
