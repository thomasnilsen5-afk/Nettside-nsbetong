---
import { Image } from 'astro:assets';
import Base from './Base.astro';
import Sidehero from '../components/Sidehero.astro';
import Faq from '../components/Faq.astro';
import Ikon from '../components/Ikon.astro';
import Galleri from '../components/Galleri.astro';
import Prosjektkort from '../components/Prosjektkort.astro';
import Tjenestekort from '../components/Tjenestekort.astro';
import Tillitsmerker from '../components/Tillitsmerker.astro';
import Kontaktseksjon from '../components/Kontaktseksjon.astro';
import { tjenesteEtterSlug, tjenester } from '../data/tjenester';
import { referanser } from '../data/referanser';
import { firma, telLenke } from '../data/site';
import { omraaderLd } from '../data/jsonld';

interface Props { slug: string }
const t = tjenesteEtterSlug(Astro.props.slug);
const url = `${firma.url}/${t.slug}/`;
const nr = String(tjenester.findIndex((x) => x.slug === t.slug) + 1).padStart(2, '0');
const prosjekter = referanser.filter((r) => r.tjenester.includes(t.slug)).slice(0, 3);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${url}#tjeneste`,
    name: t.navn,
    serviceType: t.serviceType,
    description: t.beskrivelse,
    url,
    provider: { '@id': `${firma.url}/#firma` },
    areaServed: omraaderLd,
  },
];
const smuler = [{ navn: 'Forside', sti: '/' }, { navn: t.navn, sti: `/${t.slug}/` }];
---
<Base tittel={t.tittel} beskrivelse={t.beskrivelse} jsonLd={jsonLd} smuler={smuler} ogBilde={t.hero.src}>
  <Sidehero tittel={t.h1} overtittel={`Tjeneste ${nr}`} ingress={t.ingress} bilde={t.hero.src} smuler={smuler} storrelse="stor">
    <div class="knapperad">
      <a class="knapp knapp--pil" href="#kontakt" data-cta={`tilbud_hero_${t.slug}`}>Gratis befaring<Ikon navn="pil" /></a>
      <a class="knapp knapp--omriss-lys" href={telLenke} data-cta={`ring_hero_${t.slug}`}><Ikon navn="telefon" />{firma.telefon}</a>
    </div>
  </Sidehero>

  {t.fakta && (
    <div class="faktastripe">
      <div class="beholder"><Ikon navn="team" /><p>{t.fakta}</p></div>
    </div>
  )}

  <!-- Intro + fast sidekolonne -->
  <section class="seksjon">
    <div class="beholder to-spalter">
      <div class="prosa">
        <p class="stort-utsagn">{t.intro[0]}</p>
        {t.intro.slice(1).map((p) => <p>{p}</p>)}

        <h2>{t.inngaarTittel}</h2>
        <ul class="inngaar">
          {t.inngaar.map((x, i) => (
            <li data-vis style={`--i: ${i % 3}`}><Ikon navn="hake" />{x}</li>
          ))}
        </ul>
      </div>

      <aside class="sidekolonne" aria-label="Hvorfor oss og kontakt">
        <div class="sidekort">
          <p class="sidekort__tittel">Hvorfor Nilsen &amp; Sture?</p>
          <ul class="hakeliste">{t.hvorfor.map((x) => <li>{x}</li>)}</ul>
          <a class="knapp sidekort__knapp" href={telLenke} data-cta={`ring_side_${t.slug}`}><Ikon navn="telefon" />{firma.telefon}</a>
          <a class="knapp knapp--omriss-lys sidekort__knapp" href="#kontakt" data-cta={`tilbud_side_${t.slug}`}>Send forespørsel</a>
        </div>
      </aside>
    </div>
  </section>

  {t.former && (
    <section class="seksjon seksjon--flate" aria-labelledby="former-tittel">
      <div class="beholder">
        <div class="seksjonstopp">
          <div>
            <p class="overtittel">Kantstøp</p>
            <h2 id="former-tittel">{t.former.tittel}</h2>
          </div>
          <p>{t.former.tekst}</p>
        </div>
        <ul class="former">
          {t.former.bilder.map((b, i) => (
            <li data-vis style={`--i: ${i}`}>
              <Image src={b.src} alt={b.alt} widths={[400, 800, 1200]} sizes="(min-width: 62rem) 33vw, 100vw" loading="lazy" />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <!-- Galleri -->
  <section class="seksjon seksjon--tett" aria-labelledby="bilder-tittel">
    <div class="beholder">
      <div class="seksjonstopp">
        <div>
          <p class="overtittel">Bilder</p>
          <h2 id="bilder-tittel">Fra våre prosjekter</h2>
        </div>
      </div>
      <Galleri bilder={[t.hero, ...t.bilder]} id={t.slug} />
    </div>
  </section>

  <!-- Oppdrag og målgruppe -->
  <section class="seksjon seksjon--betong">
    <div class="beholder rutenett rutenett--2">
      <div class="kort malkort" data-vis>
        <Ikon navn="bygg" klasse="malkort__ikon" />
        <h2>Typiske oppdrag</h2>
        <ul class="hakeliste">{t.oppdrag.map((x) => <li>{x}</li>)}</ul>
      </div>
      <div class="kort malkort" data-vis style="--i: 1">
        <Ikon navn="team" klasse="malkort__ikon" />
        <h2>Hvem passer det for?</h2>
        <ul class="hakeliste">{t.passerFor.map((x) => <li>{x}</li>)}</ul>
      </div>
    </div>
  </section>

  {prosjekter.length > 0 && (
    <section class="seksjon seksjon--morkest" aria-labelledby="prosjekter-tittel">
      <div class="beholder">
        <div class="seksjonstopp">
          <div>
            <p class="overtittel">Referanser</p>
            <h2 id="prosjekter-tittel">Prosjekter med {t.kortnavn.toLowerCase()}</h2>
          </div>
          <a class="tekstlenke" href="/referanser/">Alle referanser <Ikon navn="pil" /></a>
        </div>
        <div class="rutenett rutenett--3">
          {prosjekter.map((r, i) => <div data-vis style={`--i: ${i}`}><Prosjektkort r={r} /></div>)}
        </div>
      </div>
    </section>
  )}

  <!-- FAQ + godkjenninger -->
  <section class="seksjon">
    <div class="beholder to-spalter">
      <Faq sporsmal={t.faq} />
      <div>
        <p class="overtittel">Godkjenninger</p>
        <p>Godkjent for ansvarsrett, godkjent lærebedrift og våtromsbedrift, med tariffavtale og registrert i StartBANK.</p>
        <Tillitsmerker />
      </div>
    </div>
  </section>

  <section class="seksjon seksjon--flate" aria-labelledby="andre-tjenester">
    <div class="beholder">
      <div class="seksjonstopp">
        <div>
          <p class="overtittel">Flere tjenester</p>
          <h2 id="andre-tjenester">Andre tjenester</h2>
        </div>
      </div>
      <Tjenestekort utvalg={t.relaterte} />
    </div>
  </section>

  <Kontaktseksjon tittel={`Trenger du ${t.kortnavn.toLowerCase()}?`} forvalgtTjeneste={t.slug} />
</Base>

<style>
  .faktastripe {
    background: var(--farge-mork);
    color: #fff;
    border-bottom: 1px solid var(--farge-mork-3);
  }
  .faktastripe .beholder {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    padding-block: 1.1rem;
  }
  .faktastripe p {
    margin: 0;
    font-family: var(--font-overskrift);
    font-weight: 500;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    font-size: clamp(0.95rem, 1.6vw, 1.15rem);
  }
  .faktastripe :global(.ikon) {
    width: 1.8rem;
    height: 1.8rem;
    color: var(--farge-logo-rod);
  }
  .prosa .stort-utsagn {
    font-size: clamp(1.35rem, 2.3vw, 1.8rem);
    margin-bottom: 1.5rem;
  }
  .inngaar {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.6rem;
  }
  @media (min-width: 40rem) {
    .inngaar {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .inngaar li {
    display: flex;
    gap: 0.75rem;
    align-items: center;
    padding: 0.9rem 1rem;
    background: var(--farge-flate);
    border-left: 3px solid var(--farge-aksent);
    font-weight: 600;
    color: var(--farge-mork);
    line-height: 1.35;
  }
  .inngaar :global(.ikon) {
    color: var(--farge-aksent);
  }
  .sidekolonne {
    align-self: start;
  }
  @media (min-width: 62rem) {
    .sidekolonne {
      position: sticky;
      top: calc(var(--topp-hoyde) + 1.5rem);
    }
  }
  .sidekort {
    background: var(--farge-mork);
    color: var(--farge-tekst-lys);
    padding: clamp(1.5rem, 3vw, 2.25rem);
    border-top: 5px solid var(--farge-logo-rod);
  }
  .sidekort__tittel {
    font-family: var(--font-overskrift);
    font-weight: 600;
    font-size: 1.6rem;
    text-transform: uppercase;
    color: #fff;
  }
  .sidekort .hakeliste li::before {
    background: var(--farge-logo-rod);
  }
  .sidekort__knapp {
    width: 100%;
    margin-top: 0.6rem;
  }
  .former {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem;
  }
  @media (min-width: 62rem) {
    .former {
      grid-template-columns: 1.2fr 1.2fr 1fr;
    }
  }
  .former li {
    background: #fff;
    border: 1px solid var(--farge-linje);
    padding: 1rem;
    display: grid;
    place-items: center;
  }
  .malkort {
    border-top: 4px solid var(--farge-aksent);
  }
  .malkort h2 {
    font-size: clamp(1.6rem, 2.6vw, 2rem);
  }
  .malkort :global(.malkort__ikon) {
    width: 2.6rem;
    height: 2.6rem;
    color: var(--farge-aksent);
    margin-bottom: 0.75rem;
  }
</style>
